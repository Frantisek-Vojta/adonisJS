{{--
  VÝPIS UŽIVATELŮ – část „Read“ z CRUD.

  Pole `users` předává UsersController.index() jako výsledek
  User.query().orderBy('id', 'asc').
--}}
@component('components/layout', { title: 'Uživatelé' })
  @!component('components/app_header', { active: 'users' })

  <main class="mx-auto max-w-4xl px-6 py-10">
    {{-- Zelená/červená zpráva po uložení, úpravě nebo smazání --}}
    @include('components/flash_messages')

    <div class="mb-6 flex items-center justify-between">
      <div>
        <h1 class="text-xl font-semibold">Uživatelé</h1>
        {{--
          users.length funguje, protože Lucid vrací obyčejné pole modelů.
          Česká pluralizace se nedá udělat jednou větví, proto tři varianty.
        --}}
        <p class="mt-1 text-sm text-[#63635e]">
          @if(users.length === 1)
            Celkem 1 uživatel
          @elseif(users.length < 5)
            Celkem
            {{ users.length }}
            uživatelé
          @else
            Celkem
            {{ users.length }}
            uživatelů
          @end
        </p>
      </div>

      <a
        href="{{ route('users.create') }}"
        class="rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-primary-dark"
      >
        Nový uživatel
      </a>
    </div>

    <div class="overflow-hidden rounded-2xl border border-[#e2e1de] bg-white shadow-sm">
      {{-- overflow-x-auto = tabulka se na mobilu posouvá, nerozhodí stránku --}}
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-[#e2e1de] bg-[#f9f9f8]">
            <tr class="text-left text-xs uppercase tracking-wide text-[#8d8d86]">
              <th class="px-6 py-3 font-medium">ID</th>
              <th class="px-6 py-3 font-medium">Jméno</th>
              <th class="px-6 py-3 font-medium">E-mail</th>
              <th class="px-6 py-3 font-medium">Registrován</th>
              <th class="px-6 py-3 text-right font-medium">Akce</th>
            </tr>
          </thead>
          <tbody>
            {{--
              Tag @each je obdoba foreachu. Pokud by tabulka byla prázdná,
              vykreslí se místo ní řádek z větve else – prázdný výpis bez
              vysvětlení je pro uživatele matoucí.

              Prakticky se to nestane: smazat sám sebe nejde, takže
              v databázi vždycky zůstane aspoň přihlášený uživatel.
            --}}
            @each(user in users)
              <tr class="border-b border-[#f1f0ef] last:border-0">
                <td class="px-6 py-4 text-[#8d8d86]">{{ user.id }}</td>
                <td class="px-6 py-4 font-medium">{{ user.fullName || '—' }}</td>
                <td class="px-6 py-4">
                  {{ user.email }}
                  {{--
                    Označení vlastního účtu. auth.user je přihlášený
                    uživatel – do šablony ho dává middleware
                    initialize_auth a je dostupný globálně, nemusím ho
                    posílat z controlleru.
                  --}}
                  @if(auth.user.id === user.id)
                    <span class="ml-2 rounded-full bg-[#f1f0ef] px-2 py-0.5 text-xs text-[#63635e]">
                      vy
                    </span>
                  @end
                </td>
                <td class="px-6 py-4 text-[#63635e]">
                  {{ user.createdAt.setLocale('cs').toFormat('d. M. yyyy') }}
                </td>
                <td class="px-6 py-4">
                  <div class="flex items-center justify-end gap-2">
                    <a
                      href="{{ route('users.edit', [user.id]) }}"
                      class="rounded-lg border border-[#cfceca] px-3 py-1.5 text-xs font-medium transition hover:bg-[#f1f0ef]"
                    >
                      Upravit
                    </a>
                    {{--
                      Mazání je formulář (POST), ne odkaz – mění data,
                      takže musí projít CSRF kontrolou.

                      onsubmit="return confirm(...)" je poslední varování
                      před nevratnou akcí. Je to jen pohodlí uživatele,
                      ne bezpečnostní opatření – JavaScript se dá vypnout,
                      proto skutečnou kontrolu (nesmazat sám sebe) dělá
                      server v UsersController.destroy().

                      Vlastní účet nemá tlačítko vůbec, aby uživatel
                      nenarazil na chybu, kterou šlo předvídat.
                    --}}
                    @if(auth.user.id !== user.id)
                      <form
                        method="POST"
                        action="{{ route('users.destroy', [user.id]) }}"
                        onsubmit="return confirm('Opravdu smazat uživatele {{ user.email }}?')"
                      >
                        {{ csrfField() }}
                        <button
                          type="submit"
                          class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-medium text-red-700 transition hover:bg-red-50"
                        >
                          Smazat
                        </button>
                      </form>
                    @end
                  </div>
                </td>
              </tr>
            @else
              <tr>
                <td colspan="5" class="px-6 py-10 text-center text-[#8d8d86]">
                  Žádní uživatelé. Vytvořte prvního tlačítkem výše.
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    </div>
  </main>
@end
